{
  "name": "@sms/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS multi-tenant API for the SMS project (placeholder — fleshed out in Epic E3+)",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "NODE_ENV=production node dist/main.js",
    "test": "jest --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.test.json",
    "clean": "rimraf dist .turbo *.tsbuildinfo",
    "typeorm": "tsx --tsconfig tsconfig.json ./node_modules/typeorm/cli.js -d src/database/data-source.ts",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "migration:show": "pnpm run typeorm migration:show",
    "migration:create": "tsx --tsconfig tsconfig.json ./node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@nestjs/common": "^10",
    "@nestjs/config": "^3",
    "@nestjs/core": "^10",
    "@nestjs/jwt": "^10",
    "@nestjs/passport": "^10",
    "@nestjs/platform-express": "^10",
    "@nestjs/typeorm": "^10",
    "@sms/core-logic": "workspace:*",
    "bcrypt": "^5",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "dotenv": "^16",
    "passport": "^0.7",
    "passport-jwt": "^4",
    "pg": "^8",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "typeorm": "^0.3",
    "typeorm-naming-strategies": "^4"
  },
  "devDependencies": {
    "@nestjs/testing": "^10",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4"
  }
}
