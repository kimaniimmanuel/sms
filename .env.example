# Copy to .env and fill in real values. Never commit .env.
# Each value below carries a one-line comment explaining what it should be.

# ============================================================================
# API — apps/api/.env (or root .env consumed by docker compose)
# ============================================================================

# Postgres connection string. Defaults match docker-compose.yml.
DATABASE_URL=postgresql://sms:sms_dev@localhost:5432/sms

# JWT signing key for access tokens. Use a 32+ character random string in prod.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string

# Access token lifetime (e.g. 15m, 1h). Keep short.
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime.
JWT_REFRESH_EXPIRY=7d

# API listen port.
PORT=3000

# ============================================================================
# Safaricom Daraja (M-Pesa) — sandbox values for prototype
# ============================================================================

# Daraja base URL. Sandbox: https://sandbox.safaricom.co.ke
# Production:                https://api.safaricom.co.ke
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke

# Consumer key from your Daraja app.
DARAJA_CONSUMER_KEY=replace_me

# Consumer secret from your Daraja app.
DARAJA_CONSUMER_SECRET=replace_me

# Shortcode for STK Push. Sandbox default is 174379.
DARAJA_SHORTCODE=174379

# Daraja passkey (Lipa Na M-Pesa Online passkey).
DARAJA_PASSKEY=replace_me

# Publicly reachable HTTPS URL where Daraja posts the callback.
# For local dev use ngrok or Cloudflare Tunnel and paste the URL here.
DARAJA_CALLBACK_URL=https://your-ngrok-subdomain.ngrok.io/payments/callback

# ============================================================================
# PowerSync (sync engine)
# ============================================================================

# PowerSync service URL. From the PowerSync dashboard once project is created.
POWERSYNC_URL=https://your-project.powersync.io

# ============================================================================
# Logging
# ============================================================================

# debug | info | warn | error
LOG_LEVEL=info
